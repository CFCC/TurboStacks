// General Settings //

hostname "Camp Fitch Team Fortress"
sv_password ""
mp_maxrounds 5
host_framerate 0
setpause 0
sv_pure 0
sv_pausable 0
sv_lan 1
sv_stats 1



// Execute Banned Users //
exec banned_user.cfg
exec banned_ip.cfg
writeid
writeip



// Contact & Region //

sv_contact grantcohoe@campfitchymca.org
sv_region 0



// Rcon Settings //

rcon_password camper
sv_rcon_banpenalty 1440
sv_rcon_maxfailures 5



// Log Settings //

log on
sv_log_onefile 0
sv_logfile 1
sv_logbans 1
sv_logecho 1



// Rate Settings //

fps_max 600
sv_minrate 0
sv_maxrate 20000
sv_minupdaterate 66
sv_maxupdaterate 66



// Download Settings //

sv_allowupload 1
sv_allowdownload 1
net_maxfilesize 15



// Team Balancing //

mp_autoteambalance 1
mp_teams_unbalance_limit 1



// Round and Game Times //

mp_enableroundwaittime 1
mp_bonusroundtime 8
mp_restartround 0
mp_stalemate_enable 1
mp_stalemate_timelimit 300
mp_timelimit 15
mp_match_end_at_timelimit 1



// Client CVars //

mp_forcecamera 0
mp_allowspectators 1
mp_footsteps 1
sv_cheats 0
sv_timeout 900
mp_idlemaxtime 15
mp_idledealmethod 2
decalfrequency 30



// Communications //

sv_voiceenable 0
sv_alltalk 0
mp_chattime 0
tf_birthday 0
mp_respawnwavetime 5
